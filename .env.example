# Copy this file to .env and fill in the values.  NEVER commit .env.
# Tip: `order-desk new-token` prints a strong random token.

# ---- Nebius Token Factory (OpenAI-compatible) ---------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Copy the exact model IDs from the Token Factory console (Model endpoints -> card).
VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
AGENT_MODEL=nvidia/Nemotron-3_5-Lightning
# The vision model thinks before it answers and the thinking counts against this limit (KI-060).
# You pay for the tokens used, not for the limit. A reading that hits it ends in an error, never a partial order.
VISION_MAX_TOKENS=16000

# ---- Telegram bots (from @BotFather) -------------------------------------------
DEALER_BOT_TOKEN=
SHOP_BOT_TOKEN=

# ---- People ------------------------------------------------------------------------
# Your Telegram user IDs (ask @userinfobot). Comma-separated.
OWNER_TELEGRAM_IDS=
PACKER_TELEGRAM_IDS=

# ---- MCP server ----------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8710
DEALER_MCP_TOKEN=
SHOP_MCP_TOKEN=
# Optional: a token that can ONLY upload images (POST /uploads).
UPLOAD_TOKEN=
# The public HTTPS address of the tunnel in front of the MCP server
# (used by scripts/setup_nemoclaw.sh). Example: https://abc-def.trycloudflare.com
MCP_PUBLIC_URL=
# Optional: the HTTPS host name of your tunnel, for DNS-rebinding protection.
# Example: my-tunnel.trycloudflare.com
MCP_ALLOWED_HOSTS=

# NemoClaw sandbox names (the server copies photos out of them with `nemohermes <name> download`)
DEALER_SANDBOX=dealer-desk
SHOP_SANDBOX=shop-desk
NEMOHERMES_BIN=nemohermes

# ---- Business rules -------------------------------------------------------------------
SHOP_NAME=Sri Lakshmi Electricals
DEALER_CHECK_HOURS=6
OWNER_REMINDER_HOURS=2
DUPLICATE_WINDOW_HOURS=6

# ---- Storage ---------------------------------------------------------------------------
ORDER_DESK_DB=data/order_desk.sqlite3
ORDER_DESK_UPLOAD_DIR=data/uploads
ORDER_DESK_GENERATED_DIR=data/generated
